{
  "name": "astro-blur",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "A static blog theme built with Astro: posts, pages, links, projects and site search, with optional Twikoo comments.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jazee6/astro-blur"
  },
  "packageManager": "bun@1.4.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",

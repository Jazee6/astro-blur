    "@iconify-json/material-symbols": "^1.2.90",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "astro-icon": "^1.2.0",
    "medium-zoom": "^1.1.0",
    "mermaid-isomorphic": "^3.1.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "satteri": "^0.10.5",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7"

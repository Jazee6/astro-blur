---
import {getTimeline, getTitle, serializeJsonLd} from "../../utils";
import {getPublishedPosts} from "../../utils/posts";
import {normalizeTag} from "../../utils/tags";
import {siteConfig} from "../../config";
import Badge from "../../components/Badge.astro";
import {render} from 'astro:content';
import type {CollectionEntry} from 'astro:content';
import MainLayout from "../../layouts/MainLayout.astro";
import Comment from "../../components/Comment.astro";
import Toc from "../../components/Toc.astro";
import MobileToc from "../../components/MobileToc.astro";
import ImageZoom from "../../components/ImageZoom.astro";

export async function getStaticPaths() {
    // 沿文章时间线导航：上一篇为更早发布，下一篇为更晚发布
    const timeline = getTimeline(await getPublishedPosts());
    return timeline.map((post, index) => ({
        params: {slug: post.id},
        props: {
            post,
            prev: timeline[index - 1] ?? null,
            next: timeline[index + 1] ?? null,
        },
    }));
}

interface Props {
    post: CollectionEntry<'posts'>;
    prev: CollectionEntry<'posts'> | null;
    next: CollectionEntry<'posts'> | null;
}

const {post, prev, next} = Astro.props;
const {data} = post;
const {Content, headings, remarkPluginFrontmatter} = await render(post);

const articleUrl = new URL(`/posts/${post.id}`, Astro.site).href;
const blogPostingJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.pubDate.toISOString(),
    dateModified: remarkPluginFrontmatter.lastModified,
    author: {
        '@type': 'Person',
        name: siteConfig.author,
        url: siteConfig.site,
    },
    url: articleUrl,
};
---
<MainLayout title={getTitle(data.title)} description={data.description} ogType="article" pubDate={data.pubDate} lastModified={remarkPluginFrontmatter.lastModified}>
    <script is:inline slot="head" type="application/ld+json" set:html={serializeJsonLd(blogPostingJsonLd)}/>
    <Toc slot="aside" headings={headings}/>
    <div class='flex flex-col gap-4 grow min-w-0'>
        <article class="article base-card grow" data-pagefind-body>
            <h1>{data.title}</h1>

            <div class="flex gap-2 not-prose flex-wrap">
                <Badge icon="material-symbols:edit-calendar-rounded">
                    {new Date(remarkPluginFrontmatter.lastModified).toLocaleDateString(siteConfig.language)}
                </Badge>
                {data.tags.map(tag => (
                        <a href={`/tags/${encodeURIComponent(normalizeTag(tag))}`}>
                            <Badge icon="material-symbols:tag-rounded">{tag}</Badge>
                        </a>
                ))}
            </div>

            <MobileToc headings={headings}/>

            <Content/>
        </article>

        {(prev || next) && (
                <nav class="flex gap-4">
                    {prev ? (
                                    <a href={`/posts/${prev.id}`}
                                       class="flex-1 min-w-0 card p-3">
                                        <p class="text-secondary text-sm mb-1">← 上一篇</p>
                                        <p class="font-bold truncate">{prev.data.title}</p>
                                    </a>
                        ) :
                            <div class="flex-1"/>}
                    {next ? (
                                    <a href={`/posts/${next.id}`}
                                       class="flex-1 min-w-0 card p-3 text-right">
                                        <p class="text-secondary text-sm mb-1">下一篇 →</p>
                                        <p class="font-bold truncate">{next.data.title}</p>
                                    </a>
                        ) :
                            <div class="flex-1"/>}
                </nav>
        )}

        {siteConfig.twikoo_uri && <Comment/>}
    </div>
</MainLayout>

<ImageZoom/>

<script>
    // 带 hash 到达时，浏览器首次错点定位发生在图片加载前，布局变化后会漂移；
    // 等 load 后重新对齐一次（scrollIntoView 会应用 prose 标题的 scroll-my-20 偏移）
    window.addEventListener('load', () => {
        const hash = decodeURIComponent(location.hash.slice(1));
        if (!hash) return;
        document.getElementById(hash)?.scrollIntoView({block: 'start'});
    });
</script>

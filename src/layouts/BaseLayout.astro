---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {siteConfig} from "../config";
import Search from "../components/Search.astro";

interface Props {
    title?: string;
    description?: string;
    image?: string;
    ogType?: string;
    pubDate?: Date;
    lastModified?: string;
}

const {
    title = `${siteConfig.title} - ${siteConfig.description}`,
    description = siteConfig.description,
    image = siteConfig.avatar,
    ogType,
    pubDate,
    lastModified,
} = Astro.props
---

<!DOCTYPE html>
<html lang={siteConfig.language}>
<head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} pubDate={pubDate} lastModified={lastModified}>
        <slot name="head"/>
    </BaseHead>
</head>
<script is:inline>
    const setTheme = (theme) => {
        document.documentElement.classList.add(theme);
    }

    let storedTheme = null;
    try {
        storedTheme = localStorage.getItem("theme");
    } catch {
        // 某些环境（如禁用存储）会抛出 SecurityError，回退到系统偏好，避免首帧闪烁
    }

    let theme = storedTheme;
    if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    setTheme(theme);
    try {
        localStorage.setItem("theme", theme);
    } catch {
        // 忽略存储写入失败
    }
</script>
<body>
<Search/>
<Header/>
<slot/>
<Footer/>
</body>
</html>

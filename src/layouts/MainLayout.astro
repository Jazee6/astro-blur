---
import {siteConfig, socialLinks} from "../config";
import {Icon} from 'astro-icon/components'
import BaseLayout from "./BaseLayout.astro";
import type {ComponentProps} from "astro/types";

type Props = ComponentProps<typeof BaseLayout>
---
<BaseLayout {...Astro.props}>
    <Fragment slot="head">
        <slot name="head"/>
    </Fragment>
    <main class="mt-18 mb-4">
        <div class="container-global flex items-start">
            <aside class="basis-[16rem] shrink-0 max-md:hidden sticky top-18 mr-4">
                <slot name="aside">
                    <div class="base-card flex flex-col">
                        <img src={siteConfig.avatar} alt={siteConfig.author}
                             class="w-56 h-56 rounded-full dark:brightness-75"/>
                        <div class="text-center font-bold text-xl mt-4">
                            {siteConfig.author}
                        </div>
                        <div class="flex self-center mt-2 gap-2">
                            {
                                socialLinks.map((link) => (
                                        <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
                                            <Icon class="w-8 h-8 hover:text-secondary transition-colors" name={link.icon}/>
                                        </a>
                                ))
                            }
                        </div>
                    </div>
                </slot>
            </aside>

            <slot/>
        </div>
    </main>
</BaseLayout>

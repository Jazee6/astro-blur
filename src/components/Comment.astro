---
import {siteConfig} from "../config";
import {t} from "../utils/i18n";
---

{siteConfig.twikooUri && (
    <div class="bg-base rounded-xl px-6 pt-2 pb-4 mt-4">
        <div id="comment" class="h-64 animate-pulse bg-back rounded-xl mt-2" role="status" aria-label={t.commentsLoading} data-twikoo-uri={siteConfig.twikooUri} data-unavailable={t.commentsUnavailable}></div>
    </div>
)}

<script>
    // 官方 UMD 集成：从 jsDelivr 固定版本加载，带 SRI 与 crossorigin；
    // 仅在配置了 twikooUri（即页面渲染了 #comment）时才加载脚本。
    const TWIKOO_SRC = "https://cdn.jsdelivr.net/npm/twikoo@1.7.19/dist/twikoo.all.min.js";
    const TWIKOO_INTEGRITY = "sha384-7t5myh0NkFeyySL48FLh7/CLgbIezGw08uJ8be7tbH7Ko9ZOMVW5oCy+0xviw0j/";

    const container = document.getElementById("comment");
    const twikooUri = container?.dataset.twikooUri;

    if (container && twikooUri) {
        const markUnavailable = (error: unknown) => {
            console.error("Failed to load Twikoo comments:", error);
            container.classList.remove("h-64", "animate-pulse", "bg-back");
            container.removeAttribute("aria-label");
            container.textContent = container.dataset.unavailable ?? "";
        };

        const markAvailable = () => {
            // 评论渲染后移除骨架占位样式，避免长评论区被固定高度裁剪
            container.classList.remove("h-64", "animate-pulse", "bg-back");
            container.classList.add("animate-fade-in");
            container.removeAttribute("role");
            container.removeAttribute("aria-label");
        };

        const script = document.createElement("script");
        script.src = TWIKOO_SRC;
        script.integrity = TWIKOO_INTEGRITY;
        script.crossOrigin = "anonymous";
        script.onload = () => {
            const twikoo = (window as {twikoo?: {init: (options: Record<string, unknown>) => Promise<unknown>}}).twikoo;
            if (typeof twikoo?.init !== "function") {
                markUnavailable(new Error("The Twikoo UMD global is unavailable"));
                return;
            }
            try {
                twikoo.init({
                    envId: twikooUri,
                    el: "#comment",
                    lang: navigator.language,
                }).then(markAvailable).catch(markUnavailable);
            } catch (error) {
                markUnavailable(error);
            }
        };
        script.onerror = () => markUnavailable(new Error(`Failed to load ${TWIKOO_SRC}`));
        document.head.appendChild(script);
    }
</script>

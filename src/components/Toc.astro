---
interface Heading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings: Heading[];
}

const {headings} = Astro.props;
const items = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<!-- 左侧栏（≥md，由 MainLayout 的 aside 提供定位）：裸列表目录，sticky 跟随滚动，超高时内部滚动 -->
{items.length > 0 && (
    <nav class="relative base-card" aria-label="目录" data-toc style="--toc-fade-bg: rgb(var(--color-back));">
        <div class="toc-scroll overflow-y-auto max-h-[calc(100vh-6.5rem)]">
            <div class="toc-track">
                <div class="toc-indicator" aria-hidden="true"></div>
                <ul class="toc-list">
                    {items.map(h => (
                        <li class="toc-item" data-slug={h.slug} data-active="false">
                            <a
                                    class:list={[
                                        'toc-link block py-1 pr-2 text-sm leading-6 line-clamp-1 text-secondary hover:text-primary transition-colors duration-150 ease-[ease]',
                                        h.depth === 3 ? 'pl-8' : 'pl-4',
                                    ]}
                                    href={`#${h.slug}`}
                            >
                                {h.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
        <div class="toc-fade toc-fade-top" aria-hidden="true"></div>
        <div class="toc-fade toc-fade-bottom" aria-hidden="true"></div>
    </nav>
)}

<style>
    .toc-track {
        position: relative;
    }

    .toc-list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* 左侧常驻淡色竖线 */
    .toc-track::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        border-radius: 2px;
        background: rgb(var(--color-hover));
    }

    /* 激活区间的 primary 色指示条，随区间平移/伸缩 */
    .toc-indicator {
        position: absolute;
        left: 0;
        top: 0;
        width: 4px;
        height: 0;
        border-radius: 9999px;
        background: rgb(var(--color-primary));
    }

    .toc-track[data-ready] .toc-indicator {
        transition: top 200ms ease, height 200ms ease;
    }

    .toc-item[data-active='true'] a {
        color: rgb(var(--color-primary));
    }

    /* 隐藏滚动条（仍可滚动） */
    .toc-scroll {
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .toc-scroll::-webkit-scrollbar {
        display: none;
    }

    /* 可继续滚动时的上下渐变指示 */
    .toc-fade {
        position: absolute;
        inset-inline: 0;
        height: 1.25rem;
        pointer-events: none;
        opacity: 0;
        transition: opacity 150ms ease;
    }

    .toc-fade-top {
        top: 0;
        background: linear-gradient(to bottom, var(--toc-fade-bg), transparent);
    }

    .toc-fade-bottom {
        bottom: 0;
        background: linear-gradient(to top, var(--toc-fade-bg), transparent);
    }

    [data-fade-top='true'] .toc-fade-top,
    [data-fade-bottom='true'] .toc-fade-bottom {
        opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
        .toc-track[data-ready] .toc-indicator,
        .toc-fade {
            transition: none;
        }
    }
</style>

<script>
    import {debounce} from "../utils";

    const root = document.querySelector<HTMLElement>('[data-toc]');
    const scroller = root?.querySelector<HTMLElement>('.toc-scroll');
    const track = root?.querySelector<HTMLElement>('.toc-track');
    const indicator = root?.querySelector<HTMLElement>('.toc-indicator');
    const items = Array.from(root?.querySelectorAll<HTMLElement>('.toc-item') ?? [])
        .map(item => ({item, heading: document.getElementById(item.dataset.slug!)}))
        .filter((t): t is {item: HTMLElement; heading: HTMLElement} => t.heading !== null);

    if (root && scroller && track && indicator && items.length > 0) {
        // 可继续向上/向下滚动时显示渐变
        const refreshFades = () => {
            root.dataset.fadeTop = scroller.scrollTop > 1 ? 'true' : 'false';
            root.dataset.fadeBottom = scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1 ? 'true' : 'false';
        };
        scroller.addEventListener('scroll', refreshFades, {passive: true});

        // 激活区间变化时，自动滚动目录保证区间可见（不动用户手动滚动的位置）
        let rangeKey = '';
        const revealRange = (first: HTMLElement, last: HTMLElement) => {
            const key = `${first.dataset.slug}|${last.dataset.slug}`;
            if (key === rangeKey) return;
            rangeKey = key;

            const scRect = scroller.getBoundingClientRect();
            const top = first.getBoundingClientRect().top - scRect.top + scroller.scrollTop;
            const bottom = last.getBoundingClientRect().bottom - scRect.top + scroller.scrollTop;
            let target: number | null = null;
            if (bottom > scroller.scrollTop + scroller.clientHeight) {
                target = bottom - scroller.clientHeight;
            } else if (top < scroller.scrollTop) {
                target = top;
            }
            if (target !== null) {
                const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                scroller.scrollTo({top: target, behavior: reduced ? 'auto' : 'smooth'});
            }
        };

        // 激活区间：从最后一个滚过阅读线的标题，到视口内可见的最后一个标题
        // animate=false 时指示条直接跳到目标位置（初始化/resize/图片加载）
        const update = (animate: boolean) => {
            const line = 128;
            let start = 0;
            items.forEach((t, i) => {
                if (t.heading.getBoundingClientRect().top <= line) start = i;
            });
            let end = start;
            for (let i = start; i < items.length; i++) {
                if (items[i].heading.getBoundingClientRect().top < window.innerHeight) end = i;
            }
            items.forEach((t, i) => {
                t.item.dataset.active = start <= i && i <= end ? 'true' : 'false';
            });

            if (!animate) delete track.dataset.ready;
            const first = items[start].item;
            const last = items[end].item;
            indicator.style.top = `${first.offsetTop}px`;
            indicator.style.height = `${last.offsetTop + last.offsetHeight - first.offsetTop}px`;
            revealRange(first, last);
            if (!animate) {
                requestAnimationFrame(() => track.dataset.ready = 'true');
            }
            refreshFades();
        };

        document.addEventListener('scroll', debounce(() => update(true)), {passive: true});
        window.addEventListener('resize', debounce(() => update(false)));
        window.addEventListener('load', () => update(false));
        update(false);
    }
</script>

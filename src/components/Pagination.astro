---
import type {CollectionEntry} from "astro:content";
import type {Page} from "astro";
import {Icon} from 'astro-icon/components'

interface Props {
    page: Page<CollectionEntry<'posts'>>
    class?: string
    getUrl?: (page: number) => string
}

const {page, class: className, getUrl: customGetUrl} = Astro.props

let count = 1
let l = page.currentPage
let r = page.currentPage

while (0 < l - 1 && r + 1 <= page.lastPage && count + 2 <= 5) {
    count += 2;
    l--;
    r++;
}
while (0 < l - 1 && count < 5) {
    count++;
    l--;
}
while (r + 1 <= page.lastPage && count < 5) {
    count++;
    r++;
}

const pages: number[] = []
if (l > 1) pages.push(1);
if (l === 3) pages.push(2);
if (l > 3) pages.push(-1);
for (let i = l; i <= r; i++) pages.push(i);
if (r < page.lastPage - 2) pages.push(-1);
if (r === page.lastPage - 2) pages.push(page.lastPage - 1);
if (r < page.lastPage) pages.push(page.lastPage);

const getUrl = (page: number) => {
    return customGetUrl ? customGetUrl(page) : (page === 1 ? '/' : `/${page}`)
}
---
<div class:list={[className, 'flex gap-2']}>
    {page.url.prev ? (
            <a href={page.url.prev} aria-label="上一页"
               class="block p-2 rounded-xl bg-base hover:bg-hover cursor-pointer transition-colors duration-150 ease-[ease]">
                <Icon class="w-8 h-8" name="material-symbols:chevron-left-rounded"/>
            </a>
    ) : (
            <span class="block p-2 rounded-xl bg-base text-secondary" aria-hidden="true">
                <Icon class="w-8 h-8" name="material-symbols:chevron-left-rounded"/>
            </span>
    )}

    <div class="flex rounded-xl bg-base font-bold">
        {
            pages.map(p => {
                if (p === -1) {
                    return (
                            <Icon class="self-center" name="material-symbols:more-horiz" aria-hidden="true"/>
                    )
                }
                if (p === page.currentPage) {
                    return (
                            <a href={getUrl(p)} aria-current="page"
                               class="flex items-center justify-center w-12 rounded-xl bg-hover active:bg-active">
                                {p}
                            </a>
                    )
                }
                return (
                        <a href={getUrl(p)}
                           class="flex items-center justify-center w-12 rounded-xl transition-colors duration-150 ease-[ease] hover:bg-hover active:bg-active">
                            {p}
                        </a>
                )
            })
        }
    </div>

    {page.url.next ? (
            <a href={page.url.next} aria-label="下一页"
               class="block p-2 rounded-xl bg-base hover:bg-hover cursor-pointer transition-colors duration-150 ease-[ease]">
                <Icon class="w-8 h-8" name="material-symbols:chevron-right-rounded"/>
            </a>
    ) : (
            <span class="block p-2 rounded-xl bg-base text-secondary" aria-hidden="true">
                <Icon class="w-8 h-8" name="material-symbols:chevron-right-rounded"/>
            </span>
    )}
</div>

<!-- 开合过渡：hidden 切换时 display 随过渡结束才变化（transition-discrete），打开时从 starting 样式进入 -->
<div id="search-container"
     class="fixed hidden inset-0 z-50 backdrop-blur-sm transition-[opacity,display] transition-discrete starting:opacity-0 [&.hidden]:opacity-0">
    <div class="absolute top-16 left-1/2 -translate-x-1/2 container-global w-full h-full transition-[translate] starting:-translate-y-2 in-[.hidden]:-translate-y-2">
        <form class="w-3/4 mx-auto max-md:w-full" role="search">
            <label>
                <input name="search" autocomplete="off" placeholder="Search..." aria-label="搜索"
                       class="w-full outline-0 bg-base rounded-xl h-16 p-4 shadow-xl text-xl"/>
            </label>
        </form>
        <div id="search-results" class="w-3/4 mx-auto max-md:w-full h-full overflow-y-auto rounded-xl mt-1" aria-live="polite">

        </div>
    </div>
</div>

<script is:inline>
    const searchContainer = document.querySelector("#search-container");
    const searchInput = searchContainer?.querySelector("input")
    const searchResults = document.querySelector("#search-results")

    searchContainer?.addEventListener("click", (e) => {
        if (e.target !== searchInput) {
            searchContainer.classList.add("hidden")
        }
    })
    searchContainer?.querySelector("form")?.addEventListener("submit", (e) => {
        e.preventDefault()
    })

    // URL 与标题经 textContent/属性赋值写入，不拼接进 HTML 字符串；
    // 摘要 HTML（含 <mark> 高亮）由 Pagefind 基于本站索引生成，属于可信内容。
    const buildResult = (data) => {
        const anchor = document.createElement("a")
        anchor.className = "block px-4 py-2 rounded-xl bg-base/80 blur-global mt-1 first:mt-0 hover:bg-base transition-colors"
        anchor.href = data.url

        const title = document.createElement("h2")
        title.className = "text-xl font-bold line-clamp-1"
        title.textContent = data.meta?.title ?? ""

        const excerpt = document.createElement("p")
        excerpt.className = "line-clamp-3"
        excerpt.innerHTML = data.excerpt ?? ""

        anchor.append(title, excerpt)
        return anchor
    }

    // 用单调递增的查询号丢弃过期结果；缓存加载 promise，避免快速输入时重复导入
    // Pagefind，或在第一次导入完成前访问尚不存在的全局对象。
    let latestQueryId = 0
    let pagefindPromise
    const loadPagefind = () => {
        pagefindPromise ??= import("/pagefind/pagefind.js").then(pagefind => {
            pagefind.init()
            return pagefind
        })
        return pagefindPromise
    }

    searchInput?.addEventListener("input", async e => {
        const queryId = ++latestQueryId
        const input = e.target.value.trim()
        if (!input.length) {
            searchResults?.replaceChildren()
            return
        }

        try {
            const pagefind = await loadPagefind()
            if (queryId !== latestQueryId) return

            const search = await pagefind.debouncedSearch(input)
            if (search === null || queryId !== latestQueryId || !searchResults) return

            const nodes = []
            for (const result of search.results) {
                const data = await result.data()
                if (queryId !== latestQueryId) return
                nodes.push(buildResult(data))
            }
            searchResults.replaceChildren(...nodes)
        } catch (error) {
            if (queryId === latestQueryId) searchResults?.replaceChildren()
            console.error("搜索加载失败：", error)
        }
    })
</script>

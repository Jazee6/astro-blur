---
// 主题模式：light / dark / system（缺省）。只有读者手动切换后才写入 localStorage；
// system 模式下实时跟随系统配色变化。必须放在 <head> 中，首帧前完成初始化避免闪烁。
const themeColors = {light: '#f5f5f5', dark: '#171717'};
---
<meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)"/>
<meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)"/>

<script is:inline define:vars={{themeColors}}>
    const modes = ["system", "light", "dark"];
    const labels = {system: "跟随系统", light: "浅色", dark: "深色"};
    const root = document.documentElement;
    const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

    const readMode = () => {
        try {
            const stored = localStorage.getItem("theme");
            if (modes.includes(stored)) return stored;
        } catch {
            // 禁用存储时（SecurityError）回退为跟随系统
        }
        return "system";
    };

    // 读者当前选择的模式。View Transitions 的更新回调在下一帧才执行，因此用同步变量而不是
    // data-theme-mode 判断下一步，避免快速连点或点击后系统配色立即变化时读到旧值
    let currentMode = readMode();

    const apply = (mode) => {
        const theme = mode === "system" ? (systemDark.matches ? "dark" : "light") : mode;
        root.classList.remove("light", "dark");
        root.classList.add(theme);
        root.dataset.themeMode = mode;

        // 跟随系统时保留 media 区分；手动模式下两条 theme-color 都指向所选配色
        const [lightMeta, darkMeta] = document.querySelectorAll('meta[name="theme-color"]');
        if (lightMeta && darkMeta) {
            lightMeta.content = mode === "system" ? themeColors.light : themeColors[theme];
            darkMeta.content = mode === "system" ? themeColors.dark : themeColors[theme];
        }

        const button = document.getElementById("theme");
        if (button) {
            const nextMode = modes[(modes.indexOf(mode) + 1) % modes.length];
            button.setAttribute("aria-label", `主题：${labels[mode]}，点击切换为${labels[nextMode]}`);
        }
    };

    // 运行中切换主题：整页交叉淡化（View Transitions），不支持时瞬时切换。两种路径下都在换色的
    // 那一帧禁用元素自身的过渡（data-theme-switching），避免颜色分批到位。首帧初始化不经过这里。
    let switchId = 0;
    const switchTo = (mode) => {
        const id = ++switchId;
        currentMode = mode;
        const update = () => {
            root.dataset.themeSwitching = "";
            apply(mode);
        };
        // 只有最后一次切换负责移除标记，连续点击时不会提前恢复过渡
        const done = () => requestAnimationFrame(() => {
            if (id === switchId) delete root.dataset.themeSwitching;
        });

        if (typeof document.startViewTransition === "function") {
            const transition = document.startViewTransition(update);
            // 连续切换时旧过渡会被跳过，ready 以 AbortError 拒绝；这是预期行为，不当作错误
            transition.ready.catch(() => {});
            transition.finished.finally(done);
        } else {
            update();
            done();
        }
    };

    apply(currentMode);

    systemDark.addEventListener("change", () => {
        if (currentMode === "system") switchTo("system");
    });

    document.addEventListener("DOMContentLoaded", () => apply(currentMode));

    document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element) || !e.target.closest("#theme")) return;
        const mode = modes[(modes.indexOf(currentMode) + 1) % modes.length];
        switchTo(mode);
        try {
            localStorage.setItem("theme", mode);
        } catch {
            // 存储不可用时仍允许切换当前页面的主题
        }
    });
</script>
